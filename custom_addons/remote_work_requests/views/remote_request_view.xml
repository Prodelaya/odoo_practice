<odoo>

    <!-- Acción para las solicitudes de trabajo remoto -->
    <record id="action_remote_requests" model="ir.actions.act_window">
    <field name="name">Solicitudes</field>
    <field name="res_model">remote.work.request</field>
    <field name="view_mode">list,kanban,form</field>
    </record>

    <!-- Menú principal bajo Empleados -->
    <menuitem id="menu_remote_root"
              name="Trabajo Remoto"
              parent="hr.menu_hr_root"
              sequence="50"/>

    <!-- Submenú de solicitudes -->
    <menuitem id="menu_remote_requests"
              parent="menu_remote_root"
              name="Solicitudes"
              action="action_remote_requests"/>

    <!-- Vista de formulario -->
    <record id="view_remote_request_form" model="ir.ui.view">
        <field name="name">remote.request.form</field>
        <field name="model">remote.work.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Botón Enviar: solo en borrador -->
                    <button name="action_submit"
                            type="object"
                            string="Enviar"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <!-- Botón Aprobar: solo en revisión -->
                    <button name="action_approve"
                            type="object"
                            string="Aprobar"
                            class="btn-success"
                            invisible="state != 'in_review'"/>

                    <!-- Botón Rechazar: solo en revisión -->
                    <button name="action_reject"
                            type="object"
                            string="Rechazar"
                            class="btn-danger"
                            invisible="state != 'in_review'"/>
                </header>

                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="employee_id"/>
                        <field name="approver_id"/>
                        <field name="state" readonly="1"/>
                    </group>
                    <group>
                        <field name="request_date" readonly="1"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="days_count" readonly="1"/>
                        <field name="resolution_date" readonly="1"/>
                    </group>
                    <group>
                        <field name="reason"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de lista (lista desde la versión 18, antes era árbol) -->
    <record id="view_remote_request_list" model="ir.ui.view">
        <field name="name">remote.request.list</field>
        <field name="model">remote.work.request</field>
        <field name="arch" type="xml">
            <list
                decoration-muted="state == 'draft'"
                decoration-info="state == 'in_review'"
                decoration-success="state == 'approved'"
                decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="request_date"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="days_count"/>
                <field name="state"/>
                <field name="approver_id"/>
            </list>
        </field>
    </record>

    <!-- Vista kanban básica -->
    <record id="view_remote_request_kanban" model="ir.ui.view">
        <field name="name">remote.request.kanban</field>
        <field name="model">remote.work.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <!-- Campos disponibles para la vista -->
                <field name="name"/>
                <field name="employee_id"/>
                <field name="request_date"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="days_count"/>
                <field name="state"/>
                <field name="approver_id"/>

                <templates>
                    <!-- Plantilla OBLIGATORIA en Odoo nuevo: t-name="card" -->
                    <t t-name="card">
                        <div class="o_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_primary_left">
                                <strong><field name="name"/></strong>
                                <div>
                                    <field name="employee_id"/>
                                </div>
                                <div>
                                    <field name="date_start"/> - <field name="date_end"/>
                                </div>
                                <div>
                                    <field name="days_count"/> días
                                </div>
                            </div>
                            <div class="o_kanban_primary_right">
                                <div>
                                    Estado: <field name="state"/>
                                </div>
                                <div>
                                    Aprobador: <field name="approver_id"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <!-- Vista de búsqueda para solicitudes de trabajo remoto -->
    <record id="view_remote_work_request_search" model="ir.ui.view">
        <field name="name">remote.work.request.search</field>
        <field name="model">remote.work.request</field>
        <field name="arch" type="xml">
            <search string="Solicitudes de trabajo remoto">
                <!-- Búsquedas por campos básicos -->
                <field name="name"/>
                <field name="employee_id"/>
                <field name="approver_id"/>

                <!-- Filtros por estado -->
                <filter name="state_draft"
                        string="Borrador"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="state_in_review"
                        string="En revisión"
                        domain="[('state', '=', 'in_review')]"/>
                <filter name="state_approved"
                        string="Aprobadas"
                        domain="[('state', '=', 'approved')]"/>
                <filter name="state_rejected"
                        string="Rechazadas"
                        domain="[('state', '=', 'rejected')]"/>

                <!-- Mis solicitudes (yo como solicitante) -->
                <filter name="my_requests"
                        string="Mis solicitudes"
                        domain="[('user_id', '=', uid)]"/>

                <!-- Solicitudes asignadas al aprobador logueado (todos los estados) -->
                <filter name="assigned_to_me"
                        string="Asignadas a mí"
                        domain="[('approver_id', '=', uid)]"/>

                <!-- Solo las que están pendientes de revisar para mí, como revisor -->
                <filter name="pending_review_for_me"
                        string="Pendientes de revisar"
                        domain="[('approver_id', '=', uid), ('state', '=', 'in_review')]"/>

            </search>
        </field>
    </record>


</odoo>
