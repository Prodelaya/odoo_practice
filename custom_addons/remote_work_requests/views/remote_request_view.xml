<odoo>

    <!-- Acción para las solicitudes de trabajo remoto -->
    <record id="action_remote_requests" model="ir.actions.act_window">
    <field name="name">Solicitudes</field>
    <field name="res_model">remote.work.request</field>
    <field name="view_mode">list,form</field>
    </record>

    <!-- Menú -->
    <menuitem id="menu_remote_root" name="Trabajo Remoto"/>
    <menuitem id="menu_remote_requests" parent="menu_remote_root" name="Solicitudes" action="action_remote_requests"/>


    <!-- Vista de formulario -->
    <record id="view_remote_request_form" model="ir.ui.view">
        <field name="name">remote.request.form</field>
        <field name="model">remote.work.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                <!-- Botón Enviar: solo en borrador -->
                <button name="action_submit"
                        type="object"
                        string="Enviar"
                        class="btn-primary"
                        attrs="{'invisible': [('state', '!=', 'draft')]}"/>

                <!-- Botón Aprobar: solo en revisión -->
                <button name="action_approve"
                        type="object"
                        string="Aprobar"
                        class="btn-success"
                        attrs="{'invisible': [('state', '!=', 'in_review')]}"/>

                    <!-- Botón Rechazar: solo en revisión -->
                    <button name="action_reject"
                        type="object"
                        string="Rechazar"
                        class="btn-danger"
                        attrs="{'invisible': [('state', '!=', 'in_review')]}"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="employee_id"/>
                        <field name="approver_id"/>
                        <field name="state" readonly="1"/>
                    </group>
                    <group>
                        <field name="request_date" readonly="1"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="days_count" readonly="1"/>
                        <field name="resolution_date" readonly="1"/>
                    </group>
                    <group>
                        <field name="reason"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de lista (lista desde la versión 18, antes era árbol) -->
    <record id="view_remote_request_list" model="ir.ui.view">
        <field name="name">remote.request.list</field>
        <field name="model">remote.work.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="request_date"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="days_count"/>
                <field name="state"/>
                <field name="approver_id"/>
            </list>
        </field>
    </record>


</odoo>
